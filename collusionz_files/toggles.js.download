/* toggles.js — handles page visibility toggles from the vault (global, stored in site_data) */
(function() {
  'use strict';

  var ACQ_TOGGLE_KEY = 'vaultAcquaintancesEnabled';
  var checkedServer = false;

  function updateNavVisibility() {
    var acqEnabled = localStorage.getItem(ACQ_TOGGLE_KEY);
    // Default to true if not set
    var showAcq = acqEnabled !== 'false';

    // Update both desktop and mobile nav
    var navLinks = document.querySelectorAll('a[href="/acquaintances"]');
    navLinks.forEach(function(link) {
      if (showAcq) {
        link.style.display = '';
        link.style.pointerEvents = '';
        link.style.opacity = '';
      } else {
        link.style.display = 'none';
      }
    });
  }

  // Check server for global setting (site_data table)
  function checkServerSetting() {
    if (!window.Syn || !window.Syn.pull) return;
    window.Syn.pull('acquaintancesEnabled', function(serverVal) {
      var flag = (serverVal === true || serverVal === 'true') ? 'true'
        : (serverVal === false || serverVal === 'false') ? 'false' : null;
      if (!flag) return;
      var cached = localStorage.getItem(ACQ_TOGGLE_KEY);
      if (cached !== flag) {
        try { localStorage.setItem(ACQ_TOGGLE_KEY, flag); } catch(e) {}
        updateNavVisibility();
      }
      checkedServer = true;
    });
  }

  // Run on load
  updateNavVisibility();

  // Check server setting after a short delay (let sync.js load first)
  setTimeout(checkServerSetting, 100);

  // Poll for changes (for same-page vault updates)
  var lastValue = localStorage.getItem(ACQ_TOGGLE_KEY);
  setInterval(function() {
    var currentValue = localStorage.getItem(ACQ_TOGGLE_KEY);
    if (currentValue !== lastValue) {
      lastValue = currentValue;
      updateNavVisibility();
    }
  }, 500);

  // Listen for changes from other tabs/windows
  window.addEventListener('storage', function(e) {
    if (e.key === ACQ_TOGGLE_KEY || e.key === 'vaultSyncTrigger') {
      lastValue = localStorage.getItem(ACQ_TOGGLE_KEY);
      updateNavVisibility();
    }
  });

  // Also run after soft navigation (nav.js body swap)
  if (window.__navPermEventListener) {
    window.__navPermEventListener(document, 'nav:mounted', function() {
      updateNavVisibility();
      // Re-check server setting on navigation
      setTimeout(checkServerSetting, 50);
    });
  }

  // Expose for manual refresh
  window.__updateNavVisibility = updateNavVisibility;
})();
